# CODEOWNERS — required reviewers for pull requests.
#
# GitHub uses this file when branch protection is configured with
# "Require review from Code Owners". Every PR touching matched paths
# will require approval from the listed owner(s) before it can merge.
#
# Replace @freshworks-developers/devrel-maintainers with your actual
# GitHub team or individual usernames (e.g. @ashivakumar).

# Default: all changes require a maintainer review
*                                   @freshworks-developers/devrel-maintainers

# Skill content — changes to any SKILL.md or command file
skills/*/SKILL.md                   @freshworks-developers/devrel-maintainers
skills/*/commands/                  @freshworks-developers/devrel-maintainers
skills/shared/                      @freshworks-developers/devrel-maintainers

# Plugin manifests
.claude-plugin/                     @freshworks-developers/devrel-maintainers
.cursor-plugin/                     @freshworks-developers/devrel-maintainers
.codex-plugin/                      @freshworks-developers/devrel-maintainers

# CI/security workflows
.github/                            @freshworks-developers/devrel-maintainers
