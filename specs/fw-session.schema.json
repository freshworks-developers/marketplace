{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freshworks.dev/schemas/fw-session.schema.json",
  "title": "Freshworks App Session",
  "description": "Workflow state for fw-dev-tools agent orchestration (.fw-session.json at app project root). MUST NOT contain API keys, OAuth tokens, or iparam secrets.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "intent", "progress", "updated_at"],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Semver for session migrations",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "intent": {
      "type": "string",
      "description": "Last classified Confluence intent",
      "enum": [
        "create-new",
        "add-feature",
        "troubleshoot",
        "update-existing",
        "migrate",
        "publish-status"
      ]
    },
    "intent_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase"],
      "properties": {
        "phase": {
          "type": "string",
          "enum": [
            "discover",
            "setup",
            "build",
            "validate",
            "review",
            "publish",
            "done"
          ]
        },
        "milestones": {
          "type": "array",
          "items": { "type": "string" }
        },
        "app_type": {
          "type": "string",
          "description": "e.g. platform-3-react"
        }
      }
    },
    "publish": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tracking_id": { "type": "string" },
        "last_version": { "type": "string" },
        "last_status": { "type": "string" }
      }
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deploy_attempt_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "fix_attempt_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "last_error_signature": { "type": "string" }
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO8601 timestamp of last write"
    }
  }
}
